@model PresseMots.Models.ViewModels.CommentsIndexViewModel

@{
    ViewData["Title"] = "Liste des commentaires";
}

<h1>Commentaire(s) de :  </h1>

<div class="card">
    <div class="card-body">
        <!-- Utilisation du ViewModel à la place des ViewBag -->
        <div class="card-title"><h2>@Model.StoryTitle</h2></div>
        <div class="card-text">
            @Model.ShortStory (@Model.WordCount mots)
            <a asp-action="Index" asp-controller="Stories" asp-route-id="@Model.StoryId"> Consulter l'article</a>
        </div>
    </div>
</div>

<hr />

@foreach (var item in Model.Comments)
{
    <table class="table table-bordered">
        <tbody>
            <tr>
                <th style="width:30px;">
                    <!-- Utilisation du modèle de commentaire pour les libellés de colonne -->
                    @Html.DisplayNameFor(model => model.Comments.FirstOrDefault().Email)
                </th>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td style="width:150px;" rowspan="3">
                    <div>
                        <a asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>
                    </div>
                    <div>
                        <a asp-action="Edit" asp-route-id="@item.Id">Modifier</a>
                    </div>
                </td>
            </tr>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Comments.FirstOrDefault().DisplayName)
                </th>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayName)
                </td>
            </tr>
            <tr>
                <th style="white-space:pre-wrap">
                    @Html.DisplayNameFor(model => model.Comments.FirstOrDefault().Content)
                </th>
                <td>
                    @Html.DisplayFor(modelItem => item.Content)
                </td>
            </tr>
        </tbody>
    </table>
}

<!-- Remplacement final du ViewBag pour lier l'identifiant au lien de création -->
<a asp-action="Create" asp-route-storyId="@Model.StoryId">Nouveau commentaire</a>


