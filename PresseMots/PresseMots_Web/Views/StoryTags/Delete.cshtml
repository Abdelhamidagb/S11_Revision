@model PresseMots.Models.StoryTag

@{
    ViewData["Title"] = "Delete";
}

<h1>Suppression</h1>

<h3>Voulez-vous supprimer ce lien?</h3>
<div>
    <h4>StoryTag</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tag)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tag.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Story)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Story.Title)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="StoryId" />
        <input type="hidden" asp-for="TagId" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> &nbsp;
          <a asp-action="Index" asp-controller="Stories" asp-route-Id="@Model.StoryId">&laquo; Retour</a>
    </form>
</div>
